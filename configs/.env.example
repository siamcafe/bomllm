# ============================================================================
# BOMLLM — .env.example
# Copy to .env (gitignored) and replace EVERY value. Nothing here is real.
# House rule: you may say "key loaded, length=N" — never print a value.
# ============================================================================

# --- LiteLLM ----------------------------------------------------------------
# Master key: generate with `openssl rand -hex 16` then prefix sk-
LITELLM_MASTER_KEY=sk-CHANGE_ME_GENERATE_random_hex
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=CHANGE_ME_strong_password

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=litellm
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=litellm
DATABASE_URL=postgresql://litellm:CHANGE_ME_strong_password@postgres:5432/litellm

# --- Open WebUI -------------------------------------------------------------
WEBUI_SECRET_KEY=CHANGE_ME_random_32_bytes_hex

# --- Mac Ollama over Tailscale (NEVER a public IP) ---------------------------
# Format: http://100.x.y.z:11434  (your Mac's Tailscale IP)
MAC_OLLAMA_BASE_URL=http://100.CHANGE_ME.CHANGE_ME.CHANGE_ME:11434

# --- SearXNG -----------------------------------------------------------------
SEARXNG_BASE_URL=http://localhost:8888/

# --- Tier-3 cloud fallback (OPTIONAL — leave empty for hard-local) -----------
CLOUD_FALLBACK_API_KEY=CHANGE_ME_or_leave_empty

# --- Channel virtual keys (create via LiteLLM /key/generate, then paste) -----
# Each key: budget-capped, model-scoped. See docs/channels.md.
BOM_KEY_LINE=sk-CHANGE_ME
BOM_KEY_TELEGRAM=sk-CHANGE_ME
BOM_KEY_MT5=sk-CHANGE_ME
BOM_KEY_WRITER=sk-CHANGE_ME
BOM_KEY_SMOKE=sk-CHANGE_ME

# --- Bot platform credentials (live in n8n credential store, NOT here) -------
# Listed as a reminder of what must NEVER be committed anywhere:
#   LINE channel secret / access token     -> n8n credentials
#   Telegram bot token                     -> n8n credentials
#   MT5 account number / investor password -> EA ini on the terminal host only

# --- Smoke tests ---------------------------------------------------------------
SMOKE_KEY=${BOM_KEY_SMOKE}
